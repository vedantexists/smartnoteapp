# ==============================================================================
# SmartNote Backend Environment Variables Configuration
# ==============================================================================

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Storage & Persistence
# In Hugging Face Spaces Docker container, /data is the persistent volume mount point
DATA_DIR=/data
TEMP_DIR=/tmp/smartnote_media

# GitHub Integration (for starring owner/repo)
GITHUB_PAT=ghp_yourPersonalAccessTokenHere

# Spotify Integration (for saving discovered tracks to a playlist)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:7860/callback
SPOTIFY_PLAYLIST_ID=your_target_playlist_id
SPOTIFY_REFRESH_TOKEN=your_refresh_token_optional

# TMDB Integration (The Movie Database for watchlists)
TMDB_API_KEY=your_tmdb_api_key_or_v4_read_token
TMDB_ACCOUNT_ID=your_tmdb_account_id
TMDB_SESSION_ID=your_tmdb_session_id

# Notion Integration (for pushing structured notes & flashcards)
NOTION_API_KEY=secret_yourNotionIntegrationToken
NOTION_DATABASE_ID=your_notion_database_id

# yt-dlp optional cookies path for Instagram / YouTube restricted content
YTDLP_COOKIES_PATH=

# Server Configuration
HOST=0.0.0.0
PORT=7860
ENVIRONMENT=production
